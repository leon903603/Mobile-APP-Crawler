# ── 1. 資料庫連線設定 (PostgreSQL 16) ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=appcrawler
DB_USER=crawler
DB_PASS=crawlerpass
DB_POOL_SIZE=10

# ── 2. 地端檢測與報告服務 API 端點 ──────────────────────────────────────────────
# 方案 B: 專屬 Queue Wrapper (Androguard 靜態分析微服務)
DETECTION_API=http://172.27.0.19:5001/analyze_apk
# PDF 報告產生器微服務
PDF_API=http://172.27.0.14:8080/api/report

# ── 3. 檔案與報告路徑 ────────────────────────────────────────────────────────
REPORTS_DIR=reports
APK_DIR=downloads/apks

# ── 4. Google Play / APKPure 下載設定 (選填) ──────────────────────────────────
# 若未設定帳號，apkeep 自動使用免登入的 apk-pure 來源
GOOGLE_PLAY_EMAIL=
GOOGLE_PLAY_AUTH_TOKEN=
GOOGLE_PLAY_AAS_TOKEN=

# ── 5. Email 冷寄信模組設定 (Resend REST API) ──────────────────────────────────
# 必填於上線發送模式（--dry-run 模擬測試時免填）
RESEND_API_KEY=
# 安全總開關 (false=測試階段全面乾跑模擬，絕不向外部開發者發信；true=正式發送)
OUTREACH_ENABLED=false
# 每日發信上限 (預設 4 封，週一至週五 5 天共 20 封，工作時段 09:00~18:00 自動守護)
OUTREACH_DAILY_QUOTA=4
# 每週發信上限 (預設 20 封，台灣時間週一 00:00 自動日曆週歸零)
OUTREACH_WEEKLY_QUOTA=20
