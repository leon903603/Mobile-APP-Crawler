# ==============================================================================
# CMAA Mobile-APP-Crawler 環境設定範本 (.env.example)
# ==============================================================================
# 請複製此檔為 .env 並填入適當參數：
#   cp .env.example .env
# ==============================================================================

# ── 1. 檢測引擎與 PDF 產生器設定 ──────────────────────────────────────────────
# DETECTION_API:
#   - 新主機 (Precision 5860, 方案 B): http://172.27.0.19:5001/analyze_apk
#   - 舊主機 (ubuntu-2004, 方案 A):   http://localhost:8080/upload
DETECTION_API=http://172.27.0.19:5001/analyze_apk

# PDF_API:
#   - 新主機 (Precision 5860, 方案 B): http://172.27.0.14:8080/api/report
#   - 舊主機 (ubuntu-2004, 方案 A):   http://localhost:15148/api/report
PDF_API=http://172.27.0.14:8080/api/report

# ── 2. PostgreSQL 資料庫連線設定 ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=appcrawler
DB_USER=crawler
DB_PASS=crawlerpass
DB_POOL_SIZE=10

# ── 3. 爬蟲與報告存放路徑 ──────────────────────────────────────────────────────
REPORTS_DIR=reports
APK_DIR=downloads/apks

# ── 4. Google Play 官方登入 (選填：若留空則自動走免登入 APKPure 鏡像) ───────────
GOOGLE_PLAY_EMAIL=
GOOGLE_PLAY_AUTH_TOKEN=
GOOGLE_PLAY_AAS_TOKEN=

# ── 5. Email 自動發送模組設定 (選填) ──────────────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
